[Unit]
Description=Barberobot Backend API Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/barberobot
Environment="PATH=/opt/barberobot/venv/bin"
EnvironmentFile=/opt/barberobot/.env
ExecStart=/opt/barberobot/venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --no-reload
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=barberobot-backend

# Ограничения ресурсов
LimitNOFILE=65536
MemoryMax=512M

# Безопасность
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
